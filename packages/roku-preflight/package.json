{
  "name": "roku-preflight",
  "version": "1.0.0",
  "description": "Check a Roku app against current certification rules before you submit: manifest, artwork sizes, the 4 MB package cap, deep linking, deprecated APIs, the launch beacon, Memory Monitor, RAF and Roku Pay. Runs locally.",
  "keywords": [
    "roku",
    "brightscript",
    "scenegraph",
    "preflight",
    "certification",
    "cli"
  ],
  "homepage": "https://devbooth.dev",
  "bugs": {
    "url": "https://github.com/priscila225/16kb-check/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priscila225/16kb-check.git",
    "directory": "packages/roku-preflight"
  },
  "license": "MIT",
  "author": "Priscila Apocalypse",
  "bin": {
    "roku-preflight": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "npm test",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "roku-preflight": "node dist/cli.js",
    "refresh-roku-rules": "node scripts/refresh-roku-rules.mjs"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
